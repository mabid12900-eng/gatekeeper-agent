{
  "name": "gatekeeper-agent",
  "version": "1.0.0",
  "private": true,
  "description": "zkVerify Agent Games - Proof Gatekeeper agent: signed APPROVE/REJECT decisions with Groth16 proofs (snarkjs) verified via Kurier/zkVerify",
  "main": "dist/src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "test": "npm run build && node dist/test/local-test.js",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "register-vk": "node dist/scripts/register-vk.js"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
