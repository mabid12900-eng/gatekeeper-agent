# Copy this file to ".env" for LOCAL testing only.
# NEVER put real values in this file, and NEVER commit ".env" to GitHub.
# On Render, set these in the dashboard: my service -> Environment -> Environment Variables.

# --- REQUIRED ----------------------------------------------------------------
# The agent secret from the platform dashboard ("Rotate Secret").
# Required. Preflight and every task will fail without the correct value.
AGENT_GAMES_HMAC_SECRET=

# --- STRONGLY RECOMMENDED ----------------------------------------------------
# Upstash Redis REST credentials (free tier). Both must be set together.
# Without them the agent falls back to in-memory storage, which is LOST on
# every Render restart (seen proof references and cached answers disappear).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- RECOMMENDED -------------------------------------------------------------
# Kurier API key (https://kurier.xyz for mainnet, https://testnet.kurier.xyz
# for testnet). Without it, tasks that would APPROVE fail closed (REJECT).
KURIER_API_KEY=

# Kurier REST base URL.
# Mainnet (competition): https://api.kurier.xyz/api/v1
# Testnet (rehearsal):   https://api-testnet.kurier.xyz/api/v1
KURIER_API_URL=

# --- OPTIONAL ----------------------------------------------------------------
# How the text task_id becomes the circuit's numeric taskId input.
# One of: keccak | sha256 | ascii | hex-digits
# "keccak" is the current best guess - settle it with one practice task, see README.
TASK_ID_ENCODING=

# Internal timing budgets (milliseconds). Leave blank for the safe defaults.
PROOF_BUDGET_MS=
KURIER_BUDGET_MS=
DEADLINE_MARGIN_MS=

# DEV ONLY, never set on Render: 1 = answer APPROVE without submitting to Kurier.
# Automatically ignored when NODE_ENV is "production".
SKIP_KURIER=
